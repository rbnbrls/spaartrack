{
  "name": "spaartrack",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs tests/smoke/*.test.mjs",
    "db:validate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f database/schema.sql",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "5.7"
  }
}
