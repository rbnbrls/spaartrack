COMPOSE_PROJECT_NAME=spaartrack
APP_ENV=local
APP_AUTH_MODE=synthetic
# Local-only synthetic fixture credential. It unlocks POST /api/v1/test-fixtures/sessions
# and is accepted ONLY when APP_ENV=local AND APP_AUTH_MODE=synthetic, so it can never
# authenticate a deployed environment. Rotate it for any shared stack.
SYNTHETIC_FIXTURE_KEY=local-test-fixture-only
APP_RELEASE=local
LOG_LEVEL=info
POSTGRES_DB=spaartrack
POSTGRES_USER=spaartrack
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgres://spaartrack:change-me-local-only@db:5432/spaartrack
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://object-storage:9000
S3_BUCKET=spaartrack-local
S3_ACCESS_KEY=spaartrack
S3_SECRET_KEY=change-me-local-only
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000
WEB_PORT=3000
COOLIFY_DEPLOY_TOKEN=
SENTRY_DSN=

# Trading 212 credential encryption. Leave empty locally to use the persistent
# broker-secrets volume. Non-local deployments must inject the same 32-byte hex
# key into api and broker-worker through their secret store. Never commit it.
BROKER_MASTER_KEY=
